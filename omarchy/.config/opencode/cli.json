{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "houses",
    "mode": "dark"
  },
  "plugins": ["./openui", "./rex-session"],
  "tabs": {
    "mode": "off"
  },
  "keybinds": {
    "session.first": "ctrl+g,alt+home",
    "session.last": "ctrl+alt+g",
    "input.line.home": "ctrl+a,home",
    "input.line.end": "ctrl+e,end",
    "input.select.line.home": "ctrl+shift+a,ctrl+shift+home",
    "input.select.line.end": "ctrl+shift+e,ctrl+shift+end",
    "input.buffer.home": "ctrl+home",
    "input.buffer.end": "ctrl+end"
  },
  "diffs": {
    "wrap": "word",
    "single": false
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "show",
    "image_preview": true,
    "markdown": "rendered"
  },
  "animations": true,
  "attention": {
    "notifications": true,
    "sound": false,
    "volume": 1
  },
  "scroll": {
    "acceleration": true
  },
  "prompt": {
    "image_preview": true
  }
}

# Dynamic theme colors managed by Omarchy.
config-file = ?"~/.local/state/omarchy/current/theme/ghostty.conf"

# Do not inherit a stale desktop SHELL value.
command = /usr/bin/fish
env = SHELL=/usr/bin/fish

# Font
font-family = "JetBrainsMono Nerd Font"
font-style = Regular
font-size = 12

# Window
window-theme = ghostty
window-padding-x = 5
window-padding-y = 5
confirm-close-surface = false
resize-overlay = never
gtk-toolbar-style = flat

# Cursor styling
cursor-style = "block"
cursor-style-blink = true

# Keep shell integration options together.
shell-integration-features = no-cursor,ssh-env

# Scrolling and Hyprland performance
mouse-scroll-multiplier = 0.95
async-backend = epoll

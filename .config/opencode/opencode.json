{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "shell": "/opt/homebrew/bin/fish",
  "plugin": ["opencode-with-claude"],
  "provider": {
    "openai": {},
    "anthropic": {
      "options": {
        "baseURL": "http://127.0.0.1:3456",
        "apiKey": "dummy"
      }
    },
    "localllm": {
      "name": "Local LLM",
      "npm": "@ai-sdk/openai-compatible",
      "models": {
        "Qwen3.6-35B-A3B-MLX-4bit": {
          "name": "Qwen3.6-35B-A3B-MLX-4bit"
        }
      },
      "options": {
        "baseURL": "http://127.0.0.1:8000/v1",
        "apiKey": "1234"
      }
    }
  },
  "permission": {
    "read": {
      "*": "allow"
    },
    "glob": {
      "*": "allow"
    },
    "list": {
      "*": "allow"
    },
    "grep": {
      "*": "allow"
    },
    "lsp": {
      "*": "allow"
    },
    "external_directory": {
      "*": "ask",
      "/Users/manishprivet/Development/*": "allow",
      "/Users/manishprivet/.config/opencode/*": "allow",
      "/Users/manishprivet/.dotfiles/.config/opencode/*": "allow",
      "/tmp/_99/*": "allow"
    }
  },
  "mcp": {
    "slack-server": {
      "type": "local",
      "command": [
        "/bin/bash",
        "-c",
        "exec node /Users/manishprivet/Development/mcps/slack-server/build/index.js"
      ],
      "enabled": false,
      "timeout": 5000
    },
    "notion": {
      "type": "remote",
      "url": "https://mcp.notion.com/mcp",
      "enabled": false
    },
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp"
    }
  }
}

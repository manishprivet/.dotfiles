{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "shell": "/opt/homebrew/bin/fish",
  "plugins": [],
  "mcp": {
    "servers": {
      "notion": {
        "type": "remote",
        "url": "https://mcp.notion.com/mcp",
        "disabled": true
      },
      "linear": {
        "type": "remote",
        "url": "https://mcp.linear.app/mcp",
        "disabled": true
      },
      "aembit": {
        "type": "remote",
        "url": "{env:AEMBIT_MCP_URL}",
        "disabled": true,
        "oauth": {
          "redirect_uri": "http://127.0.0.1:19876/callback"
        }
      }
    }
  },
  "providers": {
    "litellm": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "LiteLLM",
      "settings": {
        "baseURL": "{env:LITELLM_BASE_URL}",
        "apiKey": "{env:LITELLM_API_KEY}"
      },
      "models": {
        "claude-sonnet-4-6-lb": {
          "name": "claude-sonnet-4-6-lb"
        },
        "claude-sonnet-5-lb": {
          "name": "claude-sonnet-5-lb"
        },
        "claude-sonnet-4-5-lb": {
          "name": "claude-sonnet-4-5-lb"
        },
        "claude-sonnet-4-lb": {
          "name": "claude-sonnet-4-lb"
        },
        "claude-opus-4-lb": {
          "name": "claude-opus-4-lb"
        },
        "claude-opus-4-1-lb": {
          "name": "claude-opus-4-1-lb"
        },
        "claude-haiku-4-5-lb": {
          "name": "claude-haiku-4-5-lb"
        },
        "claude-opus-4-5-lb": {
          "name": "claude-opus-4-5-lb"
        },
        "claude-opus-4-6-lb": {
          "name": "claude-opus-4-6-lb"
        },
        "claude-opus-4-7-lb": {
          "name": "claude-opus-4-7-lb"
        },
        "claude-opus-4-8-lb": {
          "name": "claude-opus-4-8-lb"
        },
        "openai/gpt-5.6-luna": {
          "name": "openai/gpt-5.6-luna"
        },
        "openai/gpt-5.6": {
          "name": "openai/gpt-5.6"
        },
        "openai/gpt-5.6-terra": {
          "name": "openai/gpt-5.6-terra"
        },
        "openai/gpt-5.6-sol": {
          "name": "openai/gpt-5.6-sol"
        },
        "openai/gpt-5.6-cyber": {
          "name": "openai/gpt-5.6-cyber"
        }
      }
    },
    "litellm-openai": {
      "package": "aisdk:@ai-sdk/openai",
      "name": "LiteLLM (OpenAI Responses)",
      "settings": {
        "baseURL": "{env:LITELLM_BASE_URL}",
        "apiKey": "{env:LITELLM_API_KEY}"
      },
      "models": {
        "gpt-6-sol-lb": {
          "name": "gpt-6-sol-lb"
        }
      }
    },
    "omlx": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://localhost:8000/v1",
        "apiKey": "12345"
      },
      "models": {
        "Jundot/Qwen3.6-35B-A3B-oQ4e-mtp": {},
        "Qwen3.8-27B-MLX-4bit": {}
      }
    }
  },
  "permissions": [
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "glob",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "list",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "grep",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "lsp",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "external_directory",
      "resource": "/Users/manishprivet/Development/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/Users/manishprivet/.config/opencode/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/Users/manishprivet/.dotfiles/.config/opencode/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/tmp/_99/*",
      "effect": "allow"
    }
  ]
}

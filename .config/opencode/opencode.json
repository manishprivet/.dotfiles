{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "provider": {
    "openai": {}
  },
  "permission": {
    "read": {
      "*": "allow"
    },
    "glob": {
      "*": "allow"
    },
    "list": {
      "*": "allow"
    },
    "grep": {
      "*": "allow"
    },
    "lsp": {
      "*": "allow"
    },
    "external_directory": {
      "*": "ask",
      "/Users/manishprivet/Development/*": "allow",
      "/Users/manishprivet/.config/opencode/*": "allow",
      "/Users/manishprivet/.dotfiles/.config/opencode/*": "allow",
      "/tmp/_99/*": "allow"
    }
  },
  "mcp": {
    "slack-server": {
      "type": "local",
      "command": [
        "/bin/bash",
        "-c",
        "exec node /Users/manishprivet/Development/mcps/slack-server/build/index.js"
      ],
      "enabled": false,
      "timeout": 5000
    }
  }
}

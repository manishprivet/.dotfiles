#!/bin/bash
set -euo pipefail
{{ if .omarchy -}}
omarchy pkg add {{ range .packages.omarchy }}{{ . | quote }} {{ end }}
omarchy pkg aur add {{ range .packages.omarchy_aur }}{{ . | quote }} {{ end }}
{{ else if eq .chezmoi.os "darwin" -}}
if ! command -v brew >/dev/null 2>&1; then
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  [[ ! -x /opt/homebrew/bin/brew ]] || eval "$(/opt/homebrew/bin/brew shellenv)"
  [[ ! -x /usr/local/bin/brew ]] || eval "$(/usr/local/bin/brew shellenv)"
fi
brew bundle --file=/dev/stdin <<'BREWFILE'
{{ range .packages.darwin.taps -}}
tap {{ .name | quote }}{{ if hasKey . "url" }}, {{ .url | quote }}{{ end }}{{ if hasKey . "trusted" }}, trusted: {{ .trusted }}{{ end }}
{{ end -}}
{{ range .packages.darwin.brews -}}
{{ if kindIs "string" . -}}
brew {{ . | quote }}
{{ else -}}
brew {{ .name | quote }}{{ if hasKey . "trusted" }}, trusted: {{ .trusted }}{{ end }}{{ if hasKey . "link" }}, link: {{ .link }}{{ end }}
{{ end -}}
{{ end -}}
{{ range .packages.darwin.npm -}}
npm {{ . | quote }}
{{ end -}}
BREWFILE
{{ end -}}

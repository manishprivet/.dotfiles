{{ if .omarchy -}}
#!/bin/bash
set -euo pipefail
{{ $app := joinPath .chezmoi.workingTree "omarchy/apps/notioncalendar" -}}
{{ range $pattern := list "notioncalendar.pro" "LICENSE" "bin/build" "bin/install" "src/*.*" "src/i18n/*.json" "pkgbuild/PKGBUILD" "pkgbuild/*.desktop" "pkgbuild/*.svg" -}}
{{ range $path := glob (joinPath $app $pattern) -}}
# {{ trimPrefix (printf "%s/" $app) $path }}: {{ include $path | sha256sum }}
{{ end -}}
{{ end -}}
cd {{ $app | quote }}
./bin/install --noconfirm
{{ end -}}
